# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# Supabase: Project Settings > API Keys (use the PUBLISHABLE key, never the secret key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google AI Studio: https://aistudio.google.com/apikey (server-only, no NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# The exact URL where the app runs (http://localhost:3000 locally, your live URL on Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000