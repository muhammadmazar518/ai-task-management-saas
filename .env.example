# TaskFlow AI environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# REQUIRED — Supabase project URL.
# Where: Supabase Dashboard > Project Settings > API > Project URL
# Example shape: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# REQUIRED — Supabase publishable (anon) key. Safe for the browser; protected by Row Level Security.
# Where: Supabase Dashboard > Project Settings > API > Project API keys > anon / publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# REQUIRED — Google Gemini API key used by the AI summary and recommendation routes.
# Server-side only. Never prefix with NEXT_PUBLIC.
# Where: Google AI Studio > API keys (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# OPTIONAL — Gemini model id. Defaults to gemini-2.5-flash-lite when unset.
# Where: Google AI model docs (https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-2.5-flash-lite

# REQUIRED — Public base URL of this app. Used for auth email redirects and origin checks.
# Local development: http://localhost:3000
# Production: your deployed URL, for example https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
